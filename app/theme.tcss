Screen {
    background: #090d12;
}

Header {
    background: #0ea5e9;
    color: black;
}

Footer {
    background: #0ea5e9;
    color: black;
}

Panel {
    border: solid #38bdf8;
}

Horizontal {
    height: 12;
    margin: 1 2;
}

InfoBox {
    border: round #38bdf8;
    width: 1fr;
    height: 10;
    margin: 1;
    padding: 1;
    content-align: center middle;
    color: #7dd3fc;
    background: #111827;
}

Vertical {
    align: center top;
}

Title {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #00ffff;
    margin-top: 1;
    margin-bottom: 1;
}

SystemPanel {
    border: round #22d3ee;
    background: #0b1220;
    color: white;
    margin: 1 3;
    padding: 1 2;
    height: auto;
}

#main-layout {
    width: 100%;
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 100%;
    padding: 1;
    border-right: solid cyan;
    background: #071116;
}

#sidebar Button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: none;
    background: #0b1a21;
    color: #8be9fd;
    text-style: bold;
}

#sidebar Button:hover {
    background: #12303b;
    color: white;
}

#sidebar Button:focus {
    background: #164657;
    color: white;
    border-left: thick cyan;
}

#content-area {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#screen-title {
    width: 100%;
    height: 3;
    padding: 1 2;
    margin-bottom: 1;
    border-bottom: solid cyan;
    color: #8be9fd;
    text-style: bold;
}

#system-screen {
    width: 100%;
    height: 1fr;
}

#system-panel {
    width: 100%;
    height: 10;
    padding: 1 2;
    margin-bottom: 1;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#dashboard {
    width: 100%;
    height: 11;
}

MetricCard {
    width: 1fr;
    height: 10;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

MetricCard:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

.metric-title {
    width: 100%;
    height: 1;
    color: #5bbfd8;
    text-style: bold;
}

.metric-value {
    width: 100%;
    height: 2;
    color: #d4f7ff;
    text-style: bold;
    content-align: left middle;
}

.metric-detail {
    width: 100%;
    height: 2;
    color: #70a9b8;
    text-style: dim;
    content-align: left middle;
}

MetricCard ProgressBar {
    width: 100%;
    height: 1;
    margin: 1 0;
}

MetricCard Bar > .bar--bar {
    color: #36d7ff;
    background: #12313a;
}

MetricCard Bar > .bar--complete {
    color: #36d7ff;
}

#system-screen {
    overflow-y: auto;
}

#cpu-history {
    width: 100%;
    height: 9;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

#cpu-history:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#cpu-history-header {
    width: 100%;
    height: 1;
}

#cpu-history-title {
    width: 1fr;
    height: 1;
    color: #5bbfd8;
    text-style: bold;
}

#cpu-history-stats {
    width: auto;
    height: 1;
    color: #70a9b8;
    text-align: right;
}

#cpu-sparkline {
    width: 100%;
    height: 4;
    margin-top: 1;
    background: #071116;
}

#screen-switcher {
    width: 100%;
    height: 1fr;
}

#sidebar-title {
    width: 100%;
    height: 2;
    margin-bottom: 1;
    color: #36d7ff;
    text-style: bold;
    content-align: center middle;
}

.sidebar-section {
    width: 100%;
    height: 2;
    margin-top: 1;
    color: #456d78;
    text-style: bold;
    content-align: center middle;
}

#sidebar Button.selected {
    background: #164657;
    color: #ffffff;
    border-left: thick #36d7ff;
}

#sidebar Button:disabled {
    color: #36545c;
    background: #091319;
    opacity: 60%;
}

#network-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#network-summary {
    width: 100%;
    height: 9;
}

.network-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

#network-rates {
    width: 100%;
    height: 9;
    margin-top: 1;
}

.network-rate-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #d4f7ff;
    content-align: center middle;
}

#network-history {
    width: 100%;
    height: 11;
    margin-top: 1;
}

.network-graph {
    width: 1fr;
    height: 10;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

.network-graph-title {
    width: 100%;
    height: 1;
    color: #5bbfd8;
}

.network-graph Sparkline {
    width: 100%;
    height: 5;
    margin-top: 1;
    background: #071116;
}

#network-totals {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

.network-card:hover,
.network-rate-card:hover,
.network-graph:hover,
#network-totals:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#storage-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#storage-summary {
    width: 100%;
    height: 10;
}

.storage-card {
    width: 1fr;
    height: 9;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.storage-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#storage-health {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

#storage-devices {
    width: 100%;
    height: 1fr;
    min-height: 10;
    margin-top: 1;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#storage-devices:focus {
    border: solid #36d7ff;
}

#devices-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#devices-summary {
    width: 100%;
    height: 9;
}

.devices-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.devices-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

.devices-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 1 2;
    border-bottom: solid #1f7187;
    color: #5bbfd8;
    text-style: bold;
    content-align: left middle;
}

#usb-devices-table {
    width: 100%;
    height: 14;
    min-height: 8;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#serial-devices-table {
    width: 100%;
    height: 10;
    min-height: 7;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#usb-devices-table:focus,
#serial-devices-table:focus {
    border: solid #36d7ff;
}

#projects-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#projects-summary {
    width: 100%;
    height: 9;
}

.project-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.project-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#project-focus {
    width: 100%;
    height: 8;
    margin-top: 1;
    padding: 1 2;
    border: solid #36d7ff;
    background: #0a1b22;
    color: #b8eaf5;
    content-align: left middle;
}

.projects-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 1 2;
    border-bottom: solid #1f7187;
    color: #5bbfd8;
    text-style: bold;
    content-align: left middle;
}

#projects-table {
    width: 100%;
    height: 1fr;
    min-height: 12;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#projects-table:focus {
    border: solid #36d7ff;
}

#projects-hint {
    width: 100%;
    height: 3;
    padding: 1 2;
    color: #456d78;
    content-align: right middle;
}

#logs-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#logs-summary {
    width: 100%;
    height: 9;
}

.logs-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.logs-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#logs-status {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

#logs-table {
    width: 100%;
    height: 1fr;
    min-height: 16;
    margin-top: 1;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#logs-table:focus {
    border: solid #36d7ff;
}

#logs-path {
    width: 100%;
    height: 3;
    padding: 1 2;
    color: #456d78;
    content-align: right middle;
}

#settings-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#settings-summary {
    width: 100%;
    height: 9;
}

.settings-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.settings-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#settings-status {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

#settings-form {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

.setting-row {
    width: 100%;
    height: 6;
    padding: 1;
    border-bottom: solid #12313a;
}

.setting-label {
    width: 1fr;
    height: 4;
    color: #b8eaf5;
    content-align: left middle;
}

.setting-control {
    width: 32;
    height: 3;
}

.setting-switch {
    width: 12;
    height: 3;
    margin-left: 20;
}

#settings-actions {
    width: 100%;
    height: 5;
    margin-top: 1;
    align-horizontal: right;
}

#settings-actions Button {
    width: 24;
    height: 3;
    margin-left: 1;
}

#settings-path {
    width: 100%;
    height: 3;
    padding: 1 2;
    color: #456d78;
    content-align: right middle;
}


/* SETTINGS cycle controls */
.setting-row {
    width: 100%;
    height: 7;
    padding: 1;
    border-bottom: solid #12313a;
}

.cycle-control {
    width: 34;
    height: 3;
    margin: 0;
    padding: 0;
}

.cycle-arrow {
    width: 5;
    min-width: 5;
    height: 3;
    margin: 0;
    border: none;
    background: #12313a;
    color: #36d7ff;
    text-style: bold;
}

.cycle-arrow:hover,
.cycle-arrow:focus {
    background: #164657;
    color: #ffffff;
}

.cycle-value {
    width: 1fr;
    height: 3;
    padding: 0 1;
    background: #071116;
    border-top: solid #1f7187;
    border-bottom: solid #1f7187;
    color: #d4f7ff;
    text-style: bold;
    content-align: center middle;
}

#ai-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#ai-summary {
    width: 100%;
    height: 9;
    margin: 0;
}

.ai-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.ai-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#ai-actions {
    width: 100%;
    height: 5;
    margin: 1 0 0 0;
}

.ai-action {
    width: 1fr;
    height: 3;
    margin-right: 1;
    border: none;
    background: #0b1a21;
    color: #8be9fd;
    text-style: bold;
}

.ai-action:hover,
.ai-action:focus {
    background: #164657;
    color: #ffffff;
}

#ai-transcript {
    width: 100%;
    height: 1fr;
    min-height: 18;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #050b0f;
    color: #b8eaf5;
    scrollbar-color: #1f7187;
    scrollbar-color-hover: #36d7ff;
}

#ai-transcript:focus {
    border: solid #36d7ff;
}

#ai-command-row {
    width: 100%;
    height: 5;
    margin: 1 0 0 0;
}

#ai-command {
    width: 1fr;
    height: 3;
    border: solid #1f7187;
    background: #071116;
    color: #d4f7ff;
}

#ai-command:focus {
    border: solid #36d7ff;
}

#ai-execute {
    width: 18;
    height: 3;
    margin-left: 1;
}

#ai-status-bar {
    width: 100%;
    height: 3;
    padding: 1 2;
    border-top: solid #1f7187;
    color: #70a9b8;
    content-align: left middle;
}

#modes-screen {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    padding-bottom: 1;
}

#modes-summary {
    width: 100%;
    height: 9;
    margin: 0;
}

.mode-summary-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

#mode-status {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

#mode-selector {
    width: 100%;
    height: 5;
    margin: 1 0 0 0;
}

.mode-choice {
    width: 1fr;
    height: 3;
    margin-right: 1;
    border: none;
    background: #0b1a21;
    color: #8be9fd;
    text-style: bold;
}

.mode-choice:hover,
.mode-choice:focus {
    background: #164657;
    color: #ffffff;
}

.mode-choice.selected-mode {
    border-bottom: thick #36d7ff;
    background: #12313a;
}

.mode-choice.active-mode {
    border-left: thick cyan;
    color: #ffffff;
}

#mode-details {
    width: 100%;
    height: 1fr;
    min-height: 22;
    margin-top: 1;
    padding: 2 3;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
}

#mode-details:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#mode-actions {
    width: 100%;
    height: 4;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#mode-activate {
    width: 32;
    height: 3;
}

#mode-config-path {
    width: 100%;
    height: 3;
    padding: 1 2;
    color: #456d78;
    content-align: right middle;
}

#mode-details {
    min-height: 27;
}

#mode-launch-report {
    width: 100%;
    height: auto;
    min-height: 6;
    max-height: 14;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #050b0f;
    color: #b8eaf5;
}

#mode-launch-report:hover {
    border: solid #36d7ff;
}

/* Full workspace engine */
#mode-details {
    min-height: 28;
}

#mode-launch-report {
    width: 100%;
    height: auto;
    min-height: 5;
    max-height: 14;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #050b0f;
    color: #b8eaf5;
}

#mode-launch-report:hover {
    border: solid #36d7ff;
    background: #071116;
}

/* SYSTEM Control Center v2 */

#system-inspector {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#system-detail-summary {
    width: 100%;
    height: 10;
    margin: 0;
}

.system-detail-card {
    width: 1fr;
    height: 9;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.system-detail-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#cpu-core-grid {
    width: 100%;
    height: auto;
    min-height: 9;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#cpu-core-grid:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#process-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 1 2;
    border-bottom: solid #1f7187;
    color: #5bbfd8;
    text-style: bold;
    content-align: left middle;
}

#top-processes-table {
    width: 100%;
    height: 16;
    min-height: 12;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#top-processes-table:focus {
    border: solid #36d7ff;
}

/* SYSTEM Control Center v3 */

#resource-history {
    width: 100%;
    height: 12;
    margin-top: 1;
}

#resource-history-graphs {
    width: 100%;
    height: 11;
    margin: 0;
}

.resource-history-graph {
    width: 1fr;
    height: 10;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

.resource-history-graph:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

.resource-history-title {
    width: 100%;
    height: 1;
    color: #5bbfd8;
    text-style: bold;
}

.resource-history-stats {
    width: 100%;
    height: 2;
    color: #70a9b8;
    content-align: left middle;
}

.resource-history-graph Sparkline {
    width: 100%;
    height: 4;
    margin-top: 1;
    background: #071116;
}

#system-alerts {
    width: 100%;
    height: auto;
    min-height: 4;
    max-height: 14;
    margin-top: 1;
}

#system-alert-banner {
    width: 100%;
    height: auto;
    min-height: 4;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#system-alerts.has-warning #system-alert-banner {
    border: solid yellow;
    background: #1d1a09;
}

#system-alerts.has-critical #system-alert-banner {
    border: solid red;
    background: #21090b;
}

#system-actions {
    width: 100%;
    height: 11;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

#system-actions-title {
    width: 100%;
    height: 2;
    color: #70a9b8;
}

#system-action-buttons {
    width: 100%;
    height: 4;
    margin: 0;
}

.system-action-button {
    width: 1fr;
    height: 3;
    margin-right: 1;
    border: none;
    background: #0b1a21;
    color: #8be9fd;
    text-style: bold;
}

.system-action-button:hover,
.system-action-button:focus {
    background: #164657;
    color: #ffffff;
    border-bottom: thick #36d7ff;
}

#system-action-status {
    width: 100%;
    height: 2;
    padding: 0 1;
    color: #70a9b8;
    content-align: left middle;
}

/* NETWORK Control Center v2 */

#network-diagnostic-summary {
    width: 100%;
    height: 10;
    margin: 1 0 0 0;
}

.network-diagnostic-card {
    width: 1fr;
    height: 9;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.network-diagnostic-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#network-health {
    width: 100%;
    height: auto;
    min-height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
    content-align: center middle;
}

#network-health.warning {
