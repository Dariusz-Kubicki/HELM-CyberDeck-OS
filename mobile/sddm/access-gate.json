    "theme.conf": "78a16d2fbe317a5176faa62dda7345b9f1c62307c9fd3eadf88aa073b8e22f8b",
    "wallpaper.svg": "721fc6e1368656f7984dcdae81349ddd436b36725695e885cfe039968537fb34"
  }
}
