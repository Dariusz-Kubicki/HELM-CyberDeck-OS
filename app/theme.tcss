Screen {
    background: #090d12;
}

Header {
    background: #0ea5e9;
    color: black;
}

Footer {
    background: #0ea5e9;
    color: black;
}

Panel {
    border: solid #38bdf8;
}

Horizontal {
    height: 12;
    margin: 1 2;
}

InfoBox {
    border: round #38bdf8;
    width: 1fr;
    height: 10;
    margin: 1;
    padding: 1;
    content-align: center middle;
    color: #7dd3fc;
    background: #111827;
}

Vertical {
    align: center top;
}

Title {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #00ffff;
    margin-top: 1;
    margin-bottom: 1;
}

SystemPanel {
    border: round #22d3ee;
    background: #0b1220;
    color: white;
    margin: 1 3;
    padding: 1 2;
    height: auto;
}

#main-layout {
    width: 100%;
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 100%;
    padding: 1;
    border-right: solid cyan;
    background: #071116;
}

#sidebar Button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: none;
    background: #0b1a21;
    color: #8be9fd;
    text-style: bold;
}

#sidebar Button:hover {
    background: #12303b;
    color: white;
}

#sidebar Button:focus {
    background: #164657;
    color: white;
    border-left: thick cyan;
}

#content-area {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#screen-title {
    width: 100%;
    height: 3;
    padding: 1 2;
    margin-bottom: 1;
    border-bottom: solid cyan;
    color: #8be9fd;
    text-style: bold;
}

#system-screen {
    width: 100%;
    height: 1fr;
}

#system-panel {
    width: 100%;
    height: 10;
    padding: 1 2;
    margin-bottom: 1;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#dashboard {
    width: 100%;
    height: 11;
}

MetricCard {
    width: 1fr;
    height: 10;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

MetricCard:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

.metric-title {
    width: 100%;
    height: 1;
    color: #5bbfd8;
    text-style: bold;
}

.metric-value {
    width: 100%;
    height: 2;
    color: #d4f7ff;
    text-style: bold;
    content-align: left middle;
}

.metric-detail {
    width: 100%;
    height: 2;
    color: #70a9b8;
    text-style: dim;
    content-align: left middle;
}

MetricCard ProgressBar {
    width: 100%;
    height: 1;
    margin: 1 0;
}

MetricCard Bar > .bar--bar {
    color: #36d7ff;
    background: #12313a;
}

MetricCard Bar > .bar--complete {
    color: #36d7ff;
}
