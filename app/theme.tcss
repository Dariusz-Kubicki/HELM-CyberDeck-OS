Screen {
    background: #090d12;
}

Header {
    background: #0ea5e9;
    color: black;
}

Footer {
    background: #0ea5e9;
    color: black;
}

Panel {
    border: solid #38bdf8;
}

Horizontal {
    height: 12;
    margin: 1 2;
}

InfoBox {
    border: round #38bdf8;
    width: 1fr;
    height: 10;
    margin: 1;
    padding: 1;
    content-align: center middle;
    color: #7dd3fc;
    background: #111827;
}

Vertical {
    align: center top;
}

Title {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #00ffff;
    margin-top: 1;
    margin-bottom: 1;
}

SystemPanel {
    border: round #22d3ee;
    background: #0b1220;
    color: white;
    margin: 1 3;
    padding: 1 2;
    height: auto;
}

#main-layout {
    width: 100%;
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 100%;
    padding: 1;
    border-right: solid cyan;
    background: #071116;
}

#sidebar Button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: none;
    background: #0b1a21;
    color: #8be9fd;
    text-style: bold;
}

#sidebar Button:hover {
    background: #12303b;
    color: white;
}

#sidebar Button:focus {
    background: #164657;
    color: white;
    border-left: thick cyan;
}

#content-area {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#screen-title {
    width: 100%;
    height: 3;
    padding: 1 2;
    margin-bottom: 1;
    border-bottom: solid cyan;
    color: #8be9fd;
    text-style: bold;
}

#system-screen {
    width: 100%;
    height: 1fr;
}

#system-panel {
    width: 100%;
    height: 10;
    padding: 1 2;
    margin-bottom: 1;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#dashboard {
    width: 100%;
    height: 11;
}

MetricCard {
    width: 1fr;
    height: 10;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

MetricCard:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

.metric-title {
    width: 100%;
    height: 1;
    color: #5bbfd8;
    text-style: bold;
}

.metric-value {
    width: 100%;
    height: 2;
    color: #d4f7ff;
    text-style: bold;
    content-align: left middle;
}

.metric-detail {
    width: 100%;
    height: 2;
    color: #70a9b8;
    text-style: dim;
    content-align: left middle;
}

MetricCard ProgressBar {
    width: 100%;
    height: 1;
    margin: 1 0;
}

MetricCard Bar > .bar--bar {
    color: #36d7ff;
    background: #12313a;
}

MetricCard Bar > .bar--complete {
    color: #36d7ff;
}

#system-screen {
    overflow-y: auto;
}

#cpu-history {
    width: 100%;
    height: 9;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

#cpu-history:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#cpu-history-header {
    width: 100%;
    height: 1;
}

#cpu-history-title {
    width: 1fr;
    height: 1;
    color: #5bbfd8;
    text-style: bold;
}

#cpu-history-stats {
    width: auto;
    height: 1;
    color: #70a9b8;
    text-align: right;
}

#cpu-sparkline {
    width: 100%;
    height: 4;
    margin-top: 1;
    background: #071116;
}

#screen-switcher {
    width: 100%;
    height: 1fr;
}

#sidebar-title {
    width: 100%;
    height: 2;
    margin-bottom: 1;
    color: #36d7ff;
    text-style: bold;
    content-align: center middle;
}

.sidebar-section {
    width: 100%;
    height: 2;
    margin-top: 1;
    color: #456d78;
    text-style: bold;
    content-align: center middle;
}

#sidebar Button.selected {
    background: #164657;
    color: #ffffff;
    border-left: thick #36d7ff;
}

#sidebar Button:disabled {
    color: #36545c;
    background: #091319;
    opacity: 60%;
}

#network-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#network-summary {
    width: 100%;
    height: 9;
}

.network-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

#network-rates {
    width: 100%;
    height: 9;
    margin-top: 1;
}

.network-rate-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #d4f7ff;
    content-align: center middle;
}

#network-history {
    width: 100%;
    height: 11;
    margin-top: 1;
}

.network-graph {
    width: 1fr;
    height: 10;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
}

.network-graph-title {
    width: 100%;
    height: 1;
    color: #5bbfd8;
}

.network-graph Sparkline {
    width: 100%;
    height: 5;
    margin-top: 1;
    background: #071116;
}

#network-totals {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

.network-card:hover,
.network-rate-card:hover,
.network-graph:hover,
#network-totals:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#storage-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#storage-summary {
    width: 100%;
    height: 10;
}

.storage-card {
    width: 1fr;
    height: 9;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.storage-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

#storage-health {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #071116;
    color: #70a9b8;
    content-align: center middle;
}

#storage-devices {
    width: 100%;
    height: 1fr;
    min-height: 10;
    margin-top: 1;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#storage-devices:focus {
    border: solid #36d7ff;
}

#devices-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#devices-summary {
    width: 100%;
    height: 9;
}

.devices-card {
    width: 1fr;
    height: 8;
    margin-right: 1;
    padding: 1 2;
    border: solid #1f7187;
    background: #09171d;
    color: #b8eaf5;
    content-align: center middle;
}

.devices-card:hover {
    border: solid #36d7ff;
    background: #0b1d24;
}

.devices-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 1 2;
    border-bottom: solid #1f7187;
    color: #5bbfd8;
    text-style: bold;
    content-align: left middle;
}

#usb-devices-table {
    width: 100%;
    height: 14;
    min-height: 8;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#serial-devices-table {
    width: 100%;
    height: 10;
    min-height: 7;
    border: solid #1f7187;
    background: #071116;
    color: #b8eaf5;
}

#usb-devices-table:focus,
#serial-devices-table:focus {
    border: solid #36d7ff;
}
