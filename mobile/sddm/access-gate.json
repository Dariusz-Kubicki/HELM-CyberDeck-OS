{
  "stage": "4c-sddm-access-gate",
  "version": "1.0",
  "node": "mobile",
  "architecture": {
    "access_gate": {
      "provider": "sddm",
      "purpose": "login, logout and new session creation"
    },
    "security_lock": {
      "provider": "kscreenlocker",
      "purpose": "existing session lock, idle lock and resume lock"
    },
    "interfaces_are_independent": true
  },
  "display_manager": {
    "service": "sddm.service",
    "theme": "helm-mobile",
    "qt_version": 6,
    "greeter": "/usr/bin/sddm-greeter-qt6"
  },
  "authentication": {
    "backend": "native-sddm",
    "pam_modified": false,
    "password_handling_modified": false,
    "session_launch_modified": false,
    "authentication_flow_modified": false
  },
  "integration": {
    "plasma_login_manager_modified": false,
    "ld_preload_used": false,
    "binary_interposition_used": false,
    "qml_injection_used": false
  },
  "controls": {
    "session_selector": "helm-dark",
    "authenticate_button": "helm-dark",
    "suspend": "native-sddm-capability",
    "reboot": "native-sddm-capability",
    "power_off": "native-sddm-capability"
  },
  "validation": {
    "qt6_preview_verified": true,
    "system_location_preview_verified": true,
    "real_login_verified": true,
    "journal_evidence_verified": true,
    "security_lock_preserved": true
  },
