{
  "modes": [
    {
      "id": "command",
      "name": "COMMAND",
      "description": "Default CyberDeck command and monitoring profile.",
      "telemetry_interval": 1.0,
      "target_screen": "system",
      "navigation_logging": true,
      "power_profile": "unchanged",
      "objective": "Maintain full situational awareness of the workstation.",
      "features": [
        "Live system telemetry",
        "Navigation event logging",
        "System overview on activation",
        "No additional desktop applications"
      ],
      "applications": []
    },
    {
      "id": "development",
      "name": "DEVELOPMENT",
      "description": "Programming workspace for HELM and other software projects.",
      "telemetry_interval": 0.5,
      "target_screen": "logs",
      "navigation_logging": true,
      "power_profile": "performance",
      "objective": "Prepare the workstation for programming and debugging.",
      "features": [
        "Open the HELM project in an available code editor",
        "Open Textual documentation in Firefox",
        "Display diagnostic logs",
        "Fast telemetry refresh"
      ],
      "applications": [
        {
          "name": "Code editor",
          "alternatives": [
            ["code", "{project_root}"],
            ["codium", "{project_root}"],
            ["kate", "{project_root}"]
          ],
          "process_names": ["code", "codium", "kate"],
          "skip_if_running": true,
          "working_directory": "{project_root}"
        },
        {
          "name": "Textual documentation",
          "alternatives": [
            ["firefox", "https://textual.textualize.io/"]
          ],
          "process_names": ["firefox"],
          "skip_if_running": false,
          "working_directory": "{project_root}"
        }
      ]
    },
    {
      "id": "maker",
      "name": "MAKER",
      "description": "Hardware laboratory for Arduino, ESP32 and robotics.",
      "telemetry_interval": 0.5,
      "target_screen": "devices",
      "navigation_logging": true,
      "power_profile": "performance",
      "objective": "Prepare hardware development tools and monitor connected devices.",
      "features": [
        "Start Arduino IDE",
        "Open Arduino documentation",
        "Open connected-device monitoring",
        "Fast USB and serial detection"
      ],
      "applications": [
        {
          "name": "Arduino IDE",
          "alternatives": [
            ["arduino-ide"],
            ["arduino"],
            ["flatpak", "run", "cc.arduino.IDE2"]
          ],
          "process_names": ["arduino-ide", "arduino"],
          "skip_if_running": true,
          "working_directory": "{home}"
        },
        {
          "name": "Arduino documentation",
          "alternatives": [
            ["firefox", "https://docs.arduino.cc/"]
          ],
          "process_names": ["firefox"],
          "skip_if_running": false,
          "working_directory": "{home}"
        }
      ]
    },
    {
      "id": "focus",
      "name": "FOCUS",
      "description": "Reduced-noise workspace for focused project work.",
      "telemetry_interval": 2.0,
      "target_screen": "projects",
      "navigation_logging": false,
      "power_profile": "unchanged",
      "objective": "Expose the primary objective and eliminate unnecessary activity.",
      "features": [
        "Open the PROJECTS command screen",
        "Reduced telemetry frequency",
        "Navigation logging disabled",
        "No automatically opened browser"
      ],
      "applications": []
    },
    {
      "id": "research",
      "name": "RESEARCH",
      "description": "Browser and note-taking workspace for technical research.",
      "telemetry_interval": 2.0,
      "target_screen": "projects",
      "navigation_logging": false,
      "power_profile": "unchanged",
      "objective": "Prepare documentation, browsing and note-taking tools.",
      "features": [
        "Open Firefox",
        "Open an available notes application",
        "Display current projects",
        "Reduced background telemetry"
      ],
      "applications": [
        {
          "name": "Research browser",
          "alternatives": [
            ["firefox"]
          ],
          "process_names": ["firefox"],
          "skip_if_running": true,
          "working_directory": "{home}"
        },
        {
          "name": "Notes",
          "alternatives": [
            ["obsidian"],
            ["logseq"],
            ["kate", "{project_root}/README.md"]
          ],
          "process_names": ["obsidian", "logseq", "kate"],
          "skip_if_running": true,
          "working_directory": "{project_root}"
        }
      ]
    },
    {
      "id": "low-power",
      "name": "LOW POWER",
      "description": "Minimal HELM background activity.",
      "telemetry_interval": 5.0,
      "target_screen": "system",
      "navigation_logging": false,
      "power_profile": "power-saver",
      "objective": "Minimize background work while preserving system awareness.",
      "features": [
        "Telemetry every five seconds",
        "Minimal event generation",
        "No additional applications",
        "Power profile applied when supported"
      ],
      "applications": []
    }
  ]
}
