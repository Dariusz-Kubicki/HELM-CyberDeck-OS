from __future__ import annotations

from collections import deque

from textual import work
from textual.app import ComposeResult
from textual.containers import Horizontal, Vertical
from textual.widgets import (
    Button,
    DataTable,
    Sparkline,
    Static,
)

from modules.network_diagnostics import (
    NetworkDiagnosticsMonitor,
    NetworkDiagnosticsSample,
)
from services.data_service import SystemSnapshot
from services.network_action_service import (
    NetworkActionResult,
    NetworkActionService,
)


class NetworkScreen(Vertical):
    """Live telemetry and network diagnostic control center."""

    HISTORY_SIZE = 60
    DIAGNOSTIC_INTERVAL = 8.0

    def __init__(self, *args, **kwargs) -> None:
        super().__init__(*args, **kwargs)

        self.download_history: deque[float] = deque(
            [0.0],
            maxlen=self.HISTORY_SIZE,
        )
        self.upload_history: deque[float] = deque(
            [0.0],
            maxlen=self.HISTORY_SIZE,
        )

        self.diagnostics_monitor = NetworkDiagnosticsMonitor()
        self.action_service = NetworkActionService()

        self.active_interface = "unknown"
        self.default_gateway = "N/A"
        self.network_online = False

        self._last_connection_rows: tuple[
            tuple[str, ...],
            ...,
        ] = ()

        self._last_listener_rows: tuple[
            tuple[str, ...],
            ...,
        ] = ()

    def compose(self) -> ComposeResult:
        with Horizontal(id="network-summary"):
            yield Static(
                "--",
                id="network-interface",
                classes="network-card",
            )
            yield Static(
                "--",
                id="network-ip",
                classes="network-card",
            )
            yield Static(
                "--",
                id="network-link",
                classes="network-card",
            )
            yield Static(
                "--",
                id="network-status",
                classes="network-card",
            )

        with Horizontal(id="network-rates"):
            yield Static(
                "--",
                id="download-rate",
                classes="network-rate-card",
            )
            yield Static(
                "--",
                id="upload-rate",
                classes="network-rate-card",
            )

        with Horizontal(id="network-history"):
            with Vertical(classes="network-graph"):
                yield Static(
                    "[b]DOWNLOAD // 60 SAMPLES[/b]",
                    classes="network-graph-title",
                )
                yield Sparkline(
                    [0.0],
                    min_color="#164657",
                    max_color="#36d7ff",
                    summary_function=max,
                    id="download-history",
                )

            with Vertical(classes="network-graph"):
                yield Static(
                    "[b]UPLOAD // 60 SAMPLES[/b]",
                    classes="network-graph-title",
                )
                yield Sparkline(
                    [0.0],
                    min_color="#164657",
                    max_color="#36d7ff",
                    summary_function=max,
                    id="upload-history",
                )

        yield Static(
            "TOTAL TRANSFER // WAITING FOR TELEMETRY",
            id="network-totals",
        )

        with Horizontal(id="network-diagnostic-summary"):
            yield Static(
                "--",
                id="network-gateway-card",
                classes="network-diagnostic-card",
            )
            yield Static(
                "--",
                id="network-dns-card",
                classes="network-diagnostic-card",
            )
            yield Static(
                "--",
                id="network-internet-card",
                classes="network-diagnostic-card",
            )
            yield Static(
                "--",
                id="network-sockets-card",
                classes="network-diagnostic-card",
            )

        yield Static(
            "[b cyan]● DIAGNOSTIC ENGINE STARTING[/b cyan]",
            id="network-health",
        )

        with Horizontal(id="network-action-buttons"):
            yield Button(
                "PING GATEWAY",
                id="network-action-ping-gateway",
                classes="network-action-button",
            )
            yield Button(
                "PING INTERNET",
                id="network-action-ping-internet",
                classes="network-action-button",
            )
            yield Button(
                "TRACE ROUTE",
                id="network-action-trace",
                classes="network-action-button",
            )
            yield Button(
                "DNS QUERY",
                id="network-action-dns",
                classes="network-action-button",
            )
            yield Button(
                "SOCKET MONITOR",
                id="network-action-sockets",
                classes="network-action-button",
            )

        yield Static(
            "ACTIVE CONNECTIONS // WAITING FOR SCAN",
            id="network-connections-title",
            classes="network-table-title",
        )
        yield DataTable(id="network-connections-table")

        yield Static(
            "LISTENING SOCKETS // WAITING FOR SCAN",
            id="network-listeners-title",
            classes="network-table-title",
        )
        yield DataTable(id="network-listeners-table")

        yield Static(
            "NETWORK ACTION ENGINE READY",
            id="network-action-status",
        )

    def on_mount(self) -> None:
        connections_table = self.query_one(
            "#network-connections-table",
            DataTable,
        )
        connections_table.cursor_type = "row"
        connections_table.zebra_stripes = True
        connections_table.add_columns(
            "PROTOCOL",
            "PROCESS",
            "PID",
            "LOCAL",
            "REMOTE",
            "STATE",
        )

        listeners_table = self.query_one(
            "#network-listeners-table",
            DataTable,
        )
        listeners_table.cursor_type = "row"
        listeners_table.zebra_stripes = True
        listeners_table.add_columns(
            "PROTOCOL",
            "PROCESS",
            "PID",
            "LOCAL ADDRESS",
            "SCOPE",
            "STATE",
        )

        self.set_interval(
            self.DIAGNOSTIC_INTERVAL,
            self.refresh_diagnostics,
        )
        self.refresh_diagnostics()

    def update_snapshot(
        self,
        snapshot: SystemSnapshot,
    ) -> None:
        self.active_interface = snapshot.network_interface
        self.network_online = snapshot.network_online

        download_kib = (
            snapshot.network_download_bps / 1024
        )
        upload_kib = (
            snapshot.network_upload_bps / 1024
        )

        self.download_history.append(download_kib)
        self.upload_history.append(upload_kib)

        status = (
            "ONLINE"
            if snapshot.network_online
            else "OFFLINE"
        )
        status_color = (
            "cyan"
            if snapshot.network_online
            else "red"
        )

        self.query_one(
            "#network-interface",
            Static,
        ).update(
            "[b]INTERFACE[/b]\n\n"
            f"{snapshot.network_interface}"
        )

        self.query_one(
            "#network-ip",
            Static,
        ).update(
            "[b]LOCAL IPv4[/b]\n\n"
            f"{snapshot.network_ip}"
        )

        link_speed = (
            f"{snapshot.network_link_speed} Mbps"
            if snapshot.network_link_speed > 0
            else "UNKNOWN"
        )

        self.query_one(
            "#network-link",
            Static,
        ).update(
            "[b]LINK SPEED[/b]\n\n"
            f"{link_speed}"
        )

        self.query_one(
            "#network-status",
            Static,
        ).update(
            "[b]CONNECTION[/b]\n\n"
            f"[b {status_color}]"
            f"● {status}"
            f"[/b {status_color}]"
        )

        self.query_one(
            "#download-rate",
            Static,
        ).update(
            "[b]DOWNLOAD[/b]\n\n"
            f"[b]"
            f"{self._format_rate(snapshot.network_download_bps)}"
            f"[/b]"
        )

        self.query_one(
            "#upload-rate",
            Static,
        ).update(
            "[b]UPLOAD[/b]\n\n"
            f"[b]"
            f"{self._format_rate(snapshot.network_upload_bps)}"
            f"[/b]"
        )

        self.query_one(
            "#download-history",
            Sparkline,
        ).data = list(self.download_history)

        self.query_one(
            "#upload-history",
            Sparkline,
        ).data = list(self.upload_history)

        self.query_one(
            "#network-totals",
            Static,
        ).update(
            f"[b]RECEIVED[/b]  "
            f"{self._format_bytes(snapshot.network_bytes_received)}"
            "    //    "
            f"[b]SENT[/b]  "
            f"{self._format_bytes(snapshot.network_bytes_sent)}"
            f"    //    "
            f"[b]UPDATED[/b]  {snapshot.timestamp}"
        )

    @work(
        thread=True,
        group="network-diagnostics",
        exclusive=True,
    )
    def refresh_diagnostics(self) -> None:
        sample = self.diagnostics_monitor.collect(
            self.active_interface
        )

        self.app.call_from_thread(
            self._apply_diagnostics,
            sample,
        )

    def _apply_diagnostics(
        self,
        sample: NetworkDiagnosticsSample,
    ) -> None:
        self.default_gateway = sample.gateway

        gateway_latency = self._format_latency(
            sample.gateway_latency_ms
        )

        self.query_one(
            "#network-gateway-card",
            Static,
        ).update(
            "[b]DEFAULT GATEWAY[/b]\n\n"
            f"[b]{sample.gateway}[/b]\n"
            f"LATENCY {gateway_latency}"
        )

        dns_text = (
            "\n".join(sample.dns_servers[:2])
            if sample.dns_servers
            else "NOT DETECTED"
        )

        self.query_one(
            "#network-dns-card",
            Static,
        ).update(
            "[b]DNS SERVERS[/b]\n\n"
            f"{dns_text}"
        )

        internet_latency = self._format_latency(
            sample.internet_latency_ms
        )
        packet_loss = self._format_loss(
            sample.internet_packet_loss
        )

        self.query_one(
            "#network-internet-card",
            Static,
        ).update(
            "[b]INTERNET PROBE[/b]\n\n"
            f"[b]{internet_latency}[/b]\n"
            f"LOSS {packet_loss}"
        )

        total_drops = (
            sample.drops_in
            + sample.drops_out
        )
        total_errors = (
            sample.errors_in
            + sample.errors_out
        )

        self.query_one(
            "#network-sockets-card",
            Static,
        ).update(
            "[b]SOCKET STATE[/b]\n\n"
            f"[b]{sample.established_connections}[/b] ESTABLISHED\n"
            f"{sample.listening_sockets} LISTENING"
            f"  //  DROP {total_drops}"
            f"  //  ERR {total_errors}"
        )

        self._update_health(sample)
        self._update_connection_table(sample)
        self._update_listener_table(sample)

        access_note = (
            "    //    SOCKET VISIBILITY LIMITED"
            if sample.socket_access_limited
            else ""
        )

        self.query_one(
            "#network-action-status",
            Static,
        ).update(
            "[b cyan]● DIAGNOSTIC SCAN COMPLETE[/b cyan]"
            f"    //    UPDATED {sample.updated_at}"
            f"{access_note}"
        )

    def _update_health(
        self,
        sample: NetworkDiagnosticsSample,
    ) -> None:
        issues: list[str] = []
        severity = "NOMINAL"

        if not self.network_online:
            severity = "CRITICAL"
            issues.append("PRIMARY INTERFACE OFFLINE")

        internet_loss = sample.internet_packet_loss

        if internet_loss is not None:
            if internet_loss >= 50:
                severity = "CRITICAL"
                issues.append(
                    f"INTERNET LOSS {internet_loss:.0f}%"
                )
            elif internet_loss >= 10:
                if severity != "CRITICAL":
                    severity = "WARNING"

                issues.append(
                    f"INTERNET LOSS {internet_loss:.0f}%"
                )

        latency = sample.internet_latency_ms

        if (
            latency is not None
            and latency >= 180
        ):
            if severity != "CRITICAL":
                severity = "WARNING"

            issues.append(
                f"HIGH LATENCY {latency:.0f} MS"
            )

        total_errors = (
            sample.errors_in
            + sample.errors_out
        )
        total_drops = (
            sample.drops_in
            + sample.drops_out
        )

        if total_errors > 0:
            if severity != "CRITICAL":
                severity = "WARNING"

            issues.append(
                f"INTERFACE ERRORS {total_errors}"
            )

        if total_drops >= 100:
            if severity != "CRITICAL":
                severity = "WARNING"

            issues.append(
                f"PACKET DROPS {total_drops}"
            )

        health = self.query_one(
            "#network-health",
            Static,
        )

        health.remove_class("warning")
        health.remove_class("critical")

        if severity == "CRITICAL":
            health.add_class("critical")
            state = (
                "[b red]● NETWORK CRITICAL[/b red]"
            )
        elif severity == "WARNING":
            health.add_class("warning")
            state = (
                "[b yellow]● NETWORK WARNING[/b yellow]"
            )
        else:
            state = (
                "[b cyan]● NETWORK NOMINAL[/b cyan]"
            )

        details = (
            "    //    "
            + "    //    ".join(issues)
            if issues
            else (
                "    //    GATEWAY AND INTERNET REACHABLE"
            )
        )

        health.update(state + details)

    def _update_connection_table(
        self,
        sample: NetworkDiagnosticsSample,
    ) -> None:
        rows = tuple(
            (
                connection.protocol,
                connection.process_name,
                (
                    str(connection.pid)
                    if connection.pid is not None
                    else "—"
                ),
                connection.local_address,
                connection.remote_address,
                connection.status,
            )
            for connection in sample.connections
        )

        self.query_one(
            "#network-connections-title",
            Static,
        ).update(
            "[b cyan]ACTIVE CONNECTIONS[/b cyan]"
            f"    //    TOTAL {sample.active_connections}"
            f"    //    ESTABLISHED "
            f"{sample.established_connections}"
        )

        if rows == self._last_connection_rows:
            return

        table = self.query_one(
            "#network-connections-table",
            DataTable,
        )
        table.clear()

        if rows:
            table.add_rows(rows)
        else:
            table.add_row(
                "—",
                "NO ACTIVE CONNECTIONS",
                "—",
                "—",
                "—",
                "—",
            )

        self._last_connection_rows = rows

    def _update_listener_table(
        self,
        sample: NetworkDiagnosticsSample,
    ) -> None:
        rows = tuple(
            (
                listener.protocol,
                listener.process_name,
                (
                    str(listener.pid)
                    if listener.pid is not None
                    else "—"
                ),
                listener.local_address,
                (
                    "LAN / ALL"
                    if listener.non_loopback
                    else "LOCAL"
                ),
                listener.status,
            )
            for listener in sample.listeners
        )

        self.query_one(
            "#network-listeners-title",
            Static,
        ).update(
            "[b cyan]LISTENING SOCKETS[/b cyan]"
            f"    //    TOTAL {sample.listening_sockets}"
            f"    //    NON-LOOPBACK "
            f"{sample.non_loopback_listeners}"
        )

        if rows == self._last_listener_rows:
            return

        table = self.query_one(
            "#network-listeners-table",
            DataTable,
        )
        table.clear()

        if rows:
            table.add_rows(rows)
        else:
            table.add_row(
                "—",
                "NO LISTENING SOCKETS",
                "—",
                "—",
                "—",
                "—",
            )

        self._last_listener_rows = rows

    def on_button_pressed(
        self,
        event: Button.Pressed,
    ) -> None:
        actions = {
            "network-action-ping-gateway":
                "ping-gateway",
            "network-action-ping-internet":
                "ping-internet",
            "network-action-trace":
                "trace-route",
            "network-action-dns":
                "dns-query",
            "network-action-sockets":
                "socket-monitor",
        }

        action_id = actions.get(event.button.id)

        if action_id is None:
            return

        result = self.action_service.launch(
            action_id,
            self.default_gateway,
        )

        self._show_action_result(result)
        self._log_action(result)

        event.stop()

    def _show_action_result(
        self,
        result: NetworkActionResult,
    ) -> None:
        color = {
            "LAUNCHED": "cyan",
            "UNAVAILABLE": "yellow",
            "FAILED": "red",
        }.get(result.status, "white")

        self.query_one(
            "#network-action-status",
            Static,
        ).update(
            f"[b {color}]● {result.status}[/b {color}]"
            f"    //    {result.title}"
            f"    //    {result.detail}"
        )

    def _log_action(
        self,
        result: NetworkActionResult,
    ) -> None:
        log_service = getattr(
            self.app,
            "log_service",
            None,
        )

        if log_service is None:
            return

        message = (
            f"{result.title}; "
            f"status={result.status}; "
            f"detail={result.detail}"
        )

        if result.status == "LAUNCHED":
            log_service.info(
                "NETWORK ACTION",
                message,
            )
        elif result.status == "UNAVAILABLE":
            log_service.warning(
                "NETWORK ACTION",
                message,
            )
        else:
            log_service.error(
                "NETWORK ACTION",
                message,
            )

    @staticmethod
    def _format_latency(
        value: float | None,
    ) -> str:
        if value is None:
            return "UNREACHABLE"

        return f"{value:.1f} ms"

    @staticmethod
    def _format_loss(
        value: float | None,
    ) -> str:
        if value is None:
            return "N/A"

        return f"{value:.0f}%"

    @staticmethod
    def _format_rate(
        bytes_per_second: float,
    ) -> str:
        if bytes_per_second >= 1024**2:
            return (
                f"{bytes_per_second / 1024**2:.2f} MiB/s"
            )

        if bytes_per_second >= 1024:
            return (
                f"{bytes_per_second / 1024:.1f} KiB/s"
            )

        return f"{bytes_per_second:.0f} B/s"

    @staticmethod
    def _format_bytes(value: int) -> str:
        size = float(value)

        for unit in (
            "B",
            "KiB",
            "MiB",
            "GiB",
            "TiB",
        ):
            if size < 1024 or unit == "TiB":
                return f"{size:.1f} {unit}"

            size /= 1024

        return "0 B"
