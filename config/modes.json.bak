{
  "modes": [
    {
      "id": "chill",
      "name": "CHILL",
      "description": "Codzienny, spokojny profil do oglądania filmów, przeglądania internetu i odpoczynku.",
      "telemetry_interval": 5.0,
      "target_screen": "system",
      "navigation_logging": false,
      "workload_profile": "ECO",
      "power_profile": "unchanged",
      "objective": "Ograniczyć aktywność HELM i przygotować komputer do rozrywki.",
      "features": [
        "YouTube otwierany w przeglądarce",
        "Telemetria odświeżana co 5 sekund",
        "Wyłączone logowanie nawigacji",
        "Minimalna aktywność HELM w tle"
      ],
      "applications": [
        {
          "name": "YouTube",
          "kind": "browser",
          "urls": [
            "https://www.youtube.com/"
          ]
        }
      ]
    },
    {
      "id": "maker",
      "name": "MAKER",
      "description": "Laboratorium sprzętowe do Arduino, ESP32, robotyki i diagnostyki portów szeregowych.",
      "telemetry_interval": 0.5,
      "target_screen": "devices",
      "navigation_logging": true,
      "workload_profile": "HARDWARE LAB",
      "power_profile": "unchanged",
      "objective": "Przygotować kompletne stanowisko do pracy z elektroniką.",
      "features": [
        "Automatyczne uruchomienie Arduino IDE",
        "ChatGPT, GitHub i dokumentacja Arduino w jednej sesji przeglądarki",
        "Natychmiastowe przejście do DEVICES",
        "Szybkie wykrywanie Arduino, ESP32 i portów Serial"
      ],
      "applications": [
        {
          "name": "Arduino IDE",
          "kind": "application",
          "alternatives": [
            ["arduino-ide"],
            ["arduino"],
            ["flatpak", "run", "cc.arduino.IDE2"]
          ],
          "process_names": [
            "arduino-ide",
            "arduino"
          ],
          "skip_if_running": true,
          "working_directory": "{home}"
        },
        {
          "name": "Maker browser workspace",
          "kind": "browser",
          "urls": [
            "https://chatgpt.com/",
            "https://github.com/",
            "https://docs.arduino.cc/"
          ]
        }
      ]
    },
    {
      "id": "development",
      "name": "DEVELOPMENT",
      "description": "Środowisko do rozwijania HELM, programowania i analizowania błędów.",
      "telemetry_interval": 0.5,
      "target_screen": "ai",
      "navigation_logging": true,
      "workload_profile": "DEVELOPER",
      "power_profile": "unchanged",
      "objective": "Uruchomić wszystkie narzędzia potrzebne do intensywnej pracy nad kodem.",
      "features": [
        "Otwarcie projektu HELM w dostępnym edytorze",
        "ChatGPT, GitHub i dokumentacja Textual",
        "Terminal ustawiony w katalogu projektu",
        "HELM automatycznie przechodzi do AI Diagnostic Core"
      ],
      "applications": [
        {
          "name": "Code editor",
          "kind": "application",
          "alternatives": [
            ["code", "{project_root}"],
            ["codium", "{project_root}"],
            ["kate", "{project_root}"]
          ],
          "process_names": [
            "code",
            "codium",
            "kate"
          ],
          "skip_if_running": true,
          "working_directory": "{project_root}"
        },
        {
          "name": "Development browser workspace",
          "kind": "browser",
          "urls": [
            "https://chatgpt.com/",
            "https://github.com/",
            "https://textual.textualize.io/"
          ]
        },
        {
          "name": "Project terminal",
          "kind": "application",
          "alternatives": [
            ["konsole", "--workdir", "{project_root}"],
            ["kitty", "--directory", "{project_root}"],
            ["alacritty", "--working-directory", "{project_root}"]
          ],
          "process_names": [],
          "skip_if_running": false,
          "working_directory": "{project_root}"
        }
      ]
    },
    {
      "id": "focus",
      "name": "FOCUS",
      "description": "Cichy profil do nauki i wykonywania najważniejszego zadania bez dodatkowych okien.",
      "telemetry_interval": 2.0,
      "target_screen": "projects",
      "navigation_logging": false,
      "workload_profile": "DEEP FOCUS",
      "power_profile": "unchanged",
      "objective": "Pokazać tylko bieżący cel i ograniczyć rozpraszanie.",
      "features": [
        "Automatyczne przejście do PROJECTS",
        "Brak uruchamiania przeglądarki",
        "Wyłączone logowanie nawigacji",
        "Wolniejsze odświeżanie danych"
      ],
      "applications": []
    },
    {
      "id": "command",
      "name": "COMMAND",
      "description": "Pełny profil dowodzenia i monitorowania CyberDecka.",
      "telemetry_interval": 1.0,
      "target_screen": "system",
      "navigation_logging": true,
      "workload_profile": "BALANCED",
      "power_profile": "unchanged",
      "objective": "Zapewnić pełny obraz stanu komputera bez otwierania dodatkowych programów.",
      "features": [
        "Pełna telemetria systemowa",
        "Logowanie aktywności HELM",
        "SYSTEM jako główny ekran",
        "Brak automatycznie uruchamianych aplikacji"
      ],
      "applications": []
    }
  ]
}
